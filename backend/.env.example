# Application Configuration
APP_NAME=Cloud Compliance Tool
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=postgresql://compliance:compliance@localhost:5432/compliance_db

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS Configuration (Optional - for real AWS scanning)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Azure Configuration (Optional)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# GCP Configuration (Optional)
GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=

# Compliance Rules
COMPLIANCE_RULES_PATH=compliance_rules

# Reports
REPORTS_OUTPUT_PATH=/tmp/reports
